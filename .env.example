# ==============================================================================
# SIEIS (Smart Indoor Environmental Intelligence System) - Environment Config
# ==============================================================================

# Server Settings
SECRET_KEY=sieis-secure-key-change-in-production-2026
SIEIS_HOST=0.0.0.0
SIEIS_PORT=5000
FLASK_DEBUG=false

# Physical Target ESP32 Device
SIEIS_DEVICE_ID=esp32-sieis-01
SIEIS_STALE_SECONDS=30
SIEIS_SERIAL_PORT=COM4
SIEIS_SERIAL_BAUD=115200

# Geographic Coordinates & Location Default (Vellore, Tamil Nadu, India)
SIEIS_LATITUDE=12.9165
SIEIS_LONGITUDE=79.1325
SIEIS_LOCATION_LABEL=Vellore, Tamil Nadu, India
SIEIS_TIMEZONE=Asia/Kolkata

# Outdoor Weather & Atmospheric API Configuration
# Option 1: WeatherAPI.com (Physical Weather Station Observations with last_updated_epoch)
# Get a free API key at: https://www.weatherapi.com/signup.aspx
WEATHERAPI_API_KEY=

# Provider Selection Strategy:
# - "auto" (default): Uses WeatherAPI if WEATHERAPI_API_KEY is present; gracefully falls back to Open-Meteo
# - "weatherapi": Forces WeatherAPI (requires WEATHERAPI_API_KEY)
# - "open-meteo": Uses Open-Meteo numerical weather prediction model nowcasting (no API key required)
SIEIS_WEATHER_PROVIDER=auto

# Outdoor Cache & Freshness Settings
SIEIS_OUTDOOR_TTL=45               # Backend cache duration in seconds (prevents external rate-limiting)
SIEIS_OUTDOOR_TIMEOUT=6           # HTTP timeout in seconds
SIEIS_OUTDOOR_STALE_SECONDS=7200  # Observation age threshold in seconds (2 hours) before marking STALE
